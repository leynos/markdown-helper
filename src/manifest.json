{
  "manifest_version": 2,
  "name": "Markdown Helper",
  "version": "0.1.0",
  "description": "Right-click selected text in a text box to toggle Markdown quoting, bold, italic, code spans and code blocks, or turn it into a GFM footnote.",
  "permissions": ["menus"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["markdown.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "markdown-helper@df12.net",
      "strict_min_version": "109.0"
    }
  }
}
