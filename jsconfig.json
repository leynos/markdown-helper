{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "lib": ["DOM", "ES2022"],
    "maxNodeModuleJsDepth": 0,
    "module": "commonjs",
    "noEmit": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "target": "ES2022",
    "types": ["node", "web-ext-types"]
  },
  "include": ["src/**/*.js", "src/**/*.d.ts"]
}
